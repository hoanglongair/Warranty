# =============================================
# WARRANTY PROJECT — Environment Variables
# =============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ─── DATABASE ────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/warranty"

# ─── AUTHENTICATION ──────────────────────────
JWT_SECRET="change_me_to_random_64_char_string"
NEXTAUTH_SECRET="change_me_to_random_64_char_string"

# ─── SMART CONTRACT DEPLOYMENT ───────────────
# Private key of the wallet that will deploy the contract (NO 0x prefix in Hardhat)
# WARNING: Never commit this key to git! Use a deployer wallet with limited funds.
DEPLOYER_PRIVATE_KEY="your_private_key_here_without_0x_prefix"

# RPC URL for Arc Testnet (get from Arc docs or use public endpoint)
ARC_TESTNET_RPC_URL="https://rpc.testnet.arc.network"

# Optional: ArcScan API key for contract verification on explorer
# Get from: https://testnet.arcscan.app/api
ARC_TESTNET_EXPLORER_API_KEY=""

# ─── FRONTEND (NEXT_PUBLIC_) ────────────────
# Contract address — MUST be set after deploying WarrantyEscrow
# Get this from: npx hardhat run scripts/deploy.ts --network arcTestnet
NEXT_PUBLIC_ESCROW_CONTRACT_ADDRESS=""

# RPC URL for Arc Testnet (for frontend reads via ethers.js)
NEXT_PUBLIC_ARC_RPC_URL="https://rpc.testnet.arc.network"

# ─── ARC MAINNET (future) ──────────────────
# ARC_MAINNET_RPC_URL="https://rpc.arc.network"
# NEXT_PUBLIC_ESCROW_CONTRACT_ADDRESS_MAINNET=""
